+def test_get_details_normalizes_recovered_publication_date_to_utc() -> None:
+    """Regression: `get_details` recovers `published_at`/`start_date` from
+    detail text and assigns them directly onto an already-constructed
+    `Tender`. Since `Tender.__post_init__`'s UTC normalization only runs at
+    construction time (not on later attribute assignment), the recovered
+    naive Moscow-local datetime must be explicitly re-normalized, or it
+    stays naive/un-normalized and silently breaks any downstream deadline
+    or timezone-aware comparison."""
+    bare = Tender(
