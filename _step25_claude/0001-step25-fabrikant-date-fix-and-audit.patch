         m = re.search(r"(\d{1,2})[./-](\d{1,2})[./-](20\d{2})(?:\s+(\d{1,2}):(\d{2}))?", value)
         if m:
             try:
-                return datetime(int(m.group(3)), int(m.group(2)), int(m.group(1)), int(m.group(4) or 0), int(m.group(5) or 0))
+                hour = int(m.group(4)) if m.group(4) is not None else 12
+                minute = int(m.group(5)) if m.group(5) is not None else 0
+                return datetime(int(m.group(3)), int(m.group(2)), int(m.group(1)), hour, minute)
             except ValueError:
                 return None
         m = re.search(r"(20\d{2})[./-](\d{1,2})[./-](\d{1,2})(?:[T\s]+(\d{1,2}):(\d{2}))?", value)
         if m:
             try:
