# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git — ваши пароли и ключи останутся на компьютере.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# --- Локальный ИИ Ollama ---
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# --- Email: результаты поиска Excel ---
# Mail.ru: SMTP smtp.mail.ru, SSL/TLS, порт 465.
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.mail.ru
EMAIL_SMTP_PORT=465
EMAIL_FROM=specmash_prom@mail.ru
EMAIL_PASSWORD=
EMAIL_TO=specmash_prom@mail.ru

# --- Общие настройки ---
LOG_LEVEL=INFO
