# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git — ваши ключи останутся на компьютере.

# --- Telegram (получите у @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Telegram ID администратора. Он автоматически получает доступ.
TELEGRAM_CHAT_ID=
# Дополнительные разрешённые Telegram ID через запятую.
# Пример: 123456789,987654321
# Если оставить пустым, пользоваться ботом сможет только администратор.
TELEGRAM_ALLOWED_USER_IDS=

# --- ИИ-анализ ---
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Общие настройки ---
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
