# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git — ваши ключи останутся на компьютере.

# --- Telegram (получите у @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ИИ-анализ (OpenAI или совместимый API) ---
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Общие настройки ---
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
