@@ -0,0 +1,235 @@
+"""CRM-слой поверх тендеров: статусы, ответственные, метки, дедлайны.
+
+Локальная реализация продуктовой идеи TenderPlan «метки + ответственные +
+календарь» (см. docs/TENDERPLAN_BENCHMARK.md, раздел 7). Это не копия их
+интерфейса или кода — рабочая логика построена с нуля поверх нашей
+собственной SQLite-схемы (``tender_board`` / ``tender_labels``) и опирается
+только на данные, уже накопленные Tender Intelligence Agent.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+from typing import Any
+
+from src.storage.database import TenderDatabase
+
+
+class InvalidStatusTransition(ValueError):
+    """Статус нельзя сменить напрямую — переход не входит в разрешённый workflow."""
+
+
+# Последовательность статусов повторяет воронку, описанную в бенчмарке:
+# Новый -> Проверить -> Участвуем -> Документы -> Подано -> Ожидание -> Победа/Проигрыш/Пропускаем
+STATUS_NEW = "new"
+STATUS_REVIEWING = "reviewing"
+STATUS_PARTICIPATING = "participating"
+STATUS_DOCS = "docs_preparation"
+STATUS_SUBMITTED = "submitted"
+STATUS_WAITING = "waiting_result"
+STATUS_WON = "won"
+STATUS_LOST = "lost"
+STATUS_SKIPPED = "skipped"
+
+ALL_STATUSES: tuple[str, ...] = (
+    STATUS_NEW,
+    STATUS_REVIEWING,
+    STATUS_PARTICIPATING,
+    STATUS_DOCS,
+    STATUS_SUBMITTED,
+    STATUS_WAITING,
+    STATUS_WON,
+    STATUS_LOST,
+    STATUS_SKIPPED,
+)
+
+# Статусы, которые считаются "в работе" — по ним имеет смысл напоминать о дедлайнах.
+ACTIVE_STATUSES: frozenset[str] = frozenset(
+    {
+        STATUS_REVIEWING,
+        STATUS_PARTICIPATING,
+        STATUS_DOCS,
+        STATUS_SUBMITTED,
+        STATUS_WAITING,
+    }
+)
+
+# Разрешённые переходы между статусами. Решения по тендеру могут меняться,
+# поэтому из проигрыша/пропуска можно вернуться на пересмотр, а из "участвуем"
+# можно откатиться обратно на проверку, если что-то пошло не так.
+_ALLOWED_TRANSITIONS: dict[str, frozenset[str]] = {
+    STATUS_NEW: frozenset({STATUS_REVIEWING, STATUS_SKIPPED}),
+    STATUS_REVIEWING: frozenset({STATUS_PARTICIPATING, STATUS_SKIPPED}),
+    STATUS_PARTICIPATING: frozenset({STATUS_DOCS, STATUS_SKIPPED, STATUS_REVIEWING}),
+    STATUS_DOCS: frozenset({STATUS_SUBMITTED, STATUS_SKIPPED, STATUS_PARTICIPATING}),
+    STATUS_SUBMITTED: frozenset({STATUS_WAITING, STATUS_SKIPPED}),
+    STATUS_WAITING: frozenset({STATUS_WON, STATUS_LOST, STATUS_SUBMITTED}),
+    STATUS_WON: frozenset(),
+    STATUS_LOST: frozenset({STATUS_REVIEWING}),
+    STATUS_SKIPPED: frozenset({STATUS_REVIEWING}),
+}
+
+
+@dataclass(frozen=True)
+class BoardEntry:
+    """Текущее состояние тендера на доске: статус, ответственный, метки."""
+
+    tender_id: int
+    status: str
+    assignee: str
+    labels: list[str]
+    updated_at: str
+
+
+class TenderBoard:
+    """Kanban-доска поверх таблицы ``tenders``: статус, ответственный, метки."""
+
+    def __init__(self, db: TenderDatabase) -> None:
+        self.db = db
+
+    @staticmethod
+    def _now() -> str:
+        return datetime.now(timezone.utc).isoformat()
+
+    def get_status(self, tender_id: int) -> str:
+        """Текущий статус тендера. Новый тендер без записи считается ``new``."""
+        with self.db._connect() as conn:
+            row = conn.execute(
+                "SELECT status FROM tender_board WHERE tender_id = ?", (tender_id,)
+            ).fetchone()
+        return row["status"] if row else STATUS_NEW
+
+    def set_status(self, tender_id: int, new_status: str, *, force: bool = False) -> str:
+        """Сменить статус, проверяя разрешённый переход (см. ``_ALLOWED_TRANSITIONS``).
+
+        ``force=True`` пропускает проверку — полезно для ручной коррекции
+        оператором или для тестовых сценариев.
+        """
+        if new_status not in ALL_STATUSES:
+            raise ValueError(f"Unknown status: {new_status!r}")
+
+        current = self.get_status(tender_id)
+        if not force and new_status != current:
+            allowed = _ALLOWED_TRANSITIONS.get(current, frozenset())
+            if new_status not in allowed:
+                raise InvalidStatusTransition(
+                    f"Cannot move tender {tender_id} from '{current}' to '{new_status}'"
+                )
+
+        now = self._now()
+        with self.db._connect() as conn:
+            conn.execute(
+                """
+                INSERT INTO tender_board (tender_id, status, assignee, updated_at)
+                VALUES (?, ?, '', ?)
+                ON CONFLICT(tender_id) DO UPDATE SET
+                    status = excluded.status,
+                    updated_at = excluded.updated_at
+                """,
+                (tender_id, new_status, now),
+            )
+        return new_status
+
+    def assign(self, tender_id: int, assignee: str) -> None:
+        """Назначить ответственного сотрудника, не трогая текущий статус."""
+        now = self._now()
+        with self.db._connect() as conn:
+            conn.execute(
+                """
+                INSERT INTO tender_board (tender_id, status, assignee, updated_at)
+                VALUES (?, ?, ?, ?)
+                ON CONFLICT(tender_id) DO UPDATE SET
+                    assignee = excluded.assignee,
+                    updated_at = excluded.updated_at
+                """,
+                (tender_id, STATUS_NEW, assignee.strip(), now),
+            )
+
+    def add_label(self, tender_id: int, label: str) -> None:
+        """Добавить произвольную метку (аналог меток TenderPlan: «Юристу», «Участвуем» и т.п.)."""
+        label = label.strip()
+        if not label:
+            return
+        with self.db._connect() as conn:
+            conn.execute(
+                "INSERT OR IGNORE INTO tender_labels (tender_id, label, created_at) VALUES (?, ?, ?)",
+                (tender_id, label, self._now()),
+            )
+
+    def remove_label(self, tender_id: int, label: str) -> None:
+        with self.db._connect() as conn:
+            conn.execute(
+                "DELETE FROM tender_labels WHERE tender_id = ? AND label = ?",
+                (tender_id, label.strip()),
+            )
+
+    def labels(self, tender_id: int) -> list[str]:
+        with self.db._connect() as conn:
+            rows = conn.execute(
+                "SELECT label FROM tender_labels WHERE tender_id = ? ORDER BY label",
+                (tender_id,),
+            ).fetchall()
+        return [row["label"] for row in rows]
+
+    def entry(self, tender_id: int) -> BoardEntry:
+        """Полное состояние тендера на доске одним объектом."""
+        with self.db._connect() as conn:
+            row = conn.execute(
+                "SELECT status, assignee, updated_at FROM tender_board WHERE tender_id = ?",
+                (tender_id,),
+            ).fetchone()
+        status = row["status"] if row else STATUS_NEW
+        assignee = row["assignee"] if row else ""
+        updated_at = row["updated_at"] if row else ""
+        return BoardEntry(tender_id, status, assignee, self.labels(tender_id), updated_at)
+
+    def list_by_status(self, status: str) -> list[dict[str, Any]]:
+        """Все тендеры в заданном статусе, ближайшим дедлайном вперёд — колонка канбана.
+
+        Тендеры без явной записи в ``tender_board`` считаются статусом ``new``
+        (то же соглашение, что и в ``get_status``), поэтому используется
+        ``LEFT JOIN`` с ``COALESCE`` вместо обычного ``JOIN``.
+        """
+        if status not in ALL_STATUSES:
+            raise ValueError(f"Unknown status: {status!r}")
+        with self.db._connect() as conn:
+            rows = conn.execute(
+                """
+                SELECT t.id, t.title, t.url, t.deadline, t.price, t.customer,
+                       COALESCE(b.assignee, '') AS assignee, b.updated_at
+                FROM tenders t
+                LEFT JOIN tender_board b ON b.tender_id = t.id
+                WHERE COALESCE(b.status, 'new') = ?
+                ORDER BY t.deadline IS NULL, t.deadline ASC
+                """,
+                (status,),
+            ).fetchall()
+        return [dict(row) for row in rows]
+
+    def upcoming_deadlines(self, within_days: int = 3) -> list[dict[str, Any]]:
+        """Тендеры в активных статусах с дедлайном в ближайшие ``within_days`` дней.
+
+        Это локальный аналог «календаря» TenderPlan: используется для
+        периодических напоминаний в Telegram о приближающемся сроке подачи.
+        """
+        now = datetime.now(timezone.utc)
+        horizon = now + timedelta(days=max(0, within_days))
+        if not ACTIVE_STATUSES:
+            return []
+        placeholders = ",".join("?" for _ in ACTIVE_STATUSES)
+        with self.db._connect() as conn:
+            rows = conn.execute(
+                f"""
+                SELECT t.id, t.title, t.url, t.deadline, t.price, t.customer,
+                       b.status, b.assignee
+                FROM tenders t
+                JOIN tender_board b ON b.tender_id = t.id
+                WHERE b.status IN ({placeholders})
+                  AND t.deadline IS NOT NULL
+                  AND t.deadline >= ?
+                  AND t.deadline <= ?
+                ORDER BY t.deadline ASC
+                """,
+                (*ACTIVE_STATUSES, now.isoformat(), horizon.isoformat()),
+            ).fetchall()
+        return [dict(row) for row in rows]
